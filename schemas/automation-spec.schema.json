{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidTec Automation Handoff",
  "type": "object",
  "required": [
    "ticket_id",
    "contract_version",
    "tests",
    "release_gate"
  ],
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "framework",
          "actions",
          "assertions"
        ]
      }
    },
    "release_gate": {
      "type": "string"
    }
  }
}
